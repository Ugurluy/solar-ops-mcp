{
  "name": "@yagizugurlu/pv-ops-mcp",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Explainable solar-operations MCP server with synthetic demo sites.",
  "type": "module",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ugurluy/solar-ops-mcp.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Ugurluy/solar-ops-mcp",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "node ../../scripts/require-node-22.mjs && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
