{
  "name": "pv-ops-mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Explainable solar operations over Model Context Protocol",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @pv-ops/web",
    "lint": "eslint .",
    "test": "npm run build --workspace @pv-ops/core --workspace @yagizugurlu/pv-ops-mcp && npm run test --workspaces --if-present",
    "sanitize": "node scripts/sanitize.mjs",
    "pack:inspect": "node scripts/pack-inspect.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
